<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>net.vanfleteren</groupId>
        <artifactId>jazygit-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>jazygit-github-app-tests</artifactId>

    <name>jazygit-github-app-tests</name>
    <description>The tests of the whole app with GitHub in it (ADR 171): test code only. GitHub is deleted with this
        module, features-github and core-gh.</description>

    <dependencies>
        <dependency>
            <groupId>net.vanfleteren</groupId>
            <artifactId>jazygit-app</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.vanfleteren</groupId>
            <artifactId>jazygit-app</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.vanfleteren</groupId>
            <artifactId>features-github</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.vanfleteren</groupId>
            <artifactId>features-github</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.vanfleteren</groupId>
            <artifactId>core-gh</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.vanfleteren</groupId>
            <artifactId>core-gh</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.vanfleteren</groupId>
            <artifactId>kernel-state</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.vanfleteren</groupId>
            <artifactId>kernel-ui</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.vanfleteren</groupId>
            <artifactId>features-branches</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.vanfleteren</groupId>
            <artifactId>core-git</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.vanfleteren</groupId>
            <artifactId>jazygit-test-support</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>dev.tamboui</groupId>
            <artifactId>tamboui-toolkit</artifactId>
            <classifier>test-fixtures</classifier>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>dev.tamboui</groupId>
            <artifactId>tamboui-tui</artifactId>
            <classifier>test-fixtures</classifier>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>dev.tamboui</groupId>
            <artifactId>tamboui-core</artifactId>
            <classifier>test-fixtures</classifier>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- GitHub's tests of the whole app run without Forgejo, which they know nothing of, so that no
                         test asks a host on the network whether it is Forgejo (ADR 174). -->
                    <systemPropertyVariables>
                        <jazygit.without>forgejo</jazygit.without>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
