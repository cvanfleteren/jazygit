<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!-- Only member-ordering checks; formatting is handled by Spotless. -->
<module name="Checker">
    <property name="severity" value="error"/>
    <!-- Tests keep their fixtures at the top, next to the tests that use them. -->
    <module name="SuppressionSingleFilter">
        <property name="checks" value="\.(InnerTypeLast|DeclarationOrder)Check$"/>
        <property name="files" value="[\\/]src[\\/]test[\\/]"/>
    </module>
    <module name="TreeWalker">
        <module name="DeclarationOrder"/>
        <module name="ConstructorsDeclarationGrouping"/>
        <module name="OverloadMethodsDeclarationOrder"/>
        <module name="InnerTypeLast"/>
    </module>
</module>
