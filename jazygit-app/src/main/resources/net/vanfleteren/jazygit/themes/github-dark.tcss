/*
 * The palette of GitHub's dark theme (Primer's "dark default"). Its translucent backgrounds, such as those of
 * the lines of a diff, are laid over the canvas here, as a terminal has no transparency.
 */
$fg: #e6edf3;
$bg: #0d1117;
$subtle: #161b22;
/* Darker than GitHub's own borders, as the titles of the panes are drawn in this colour. */
$border: #6e7681;
$accent: #2f81f7;
$link: #58a6ff;
$muted: #7d8590;
$selection: #1e4273;
$added: #3fb950;
$removed: #f85149;
$attention: #d29922;
$done: #a371f7;

* {
    color: $fg;
    background: $bg;
}

Panel, TextInputElement, TextAreaElement, RichTextAreaElement {
    border-type: rounded;
    border-color: $border;
}

/* The pane in use, the area of the content panel that has the focus, and the field of a popup that has it. */
Panel.focused, RichTextAreaElement:focus, TextInputElement:focus, TextAreaElement:focus {
    border-color: $accent;
}

/* Popups, which otherwise take the terminal's own colour. */
DialogElement {
    border-color: $accent;
}

/*
 * The highlighted row: in the left pane in use, and in popups; in the other left panes it is hidden, as the
 * empty rule says. Only what these rules declare themselves is laid over the row.
 */
ListElement-item:selected, TreeElement-node:selected, .selection {
    background: $selection;
}

.inactive-selection {
}

/* Plain text on the highlighted row; the coloured pieces of the row keep their colours. */
.selected-text { color: #ffffff; }

/*
 * Behind an open popup, text in the plain colour takes this one; the rest is dimmed by the terminal, which
 * not every terminal does for its default colour.
 */
.backdrop { color: $muted; }

.bold { text-style: bold; }
.dim { color: $muted; }
.error { color: $removed; }
.notice { color: $attention; }
.in-progress { color: $removed; text-style: bold; }
.disabled { color: $muted; text-style: crossed-out; }
.staged { color: $added; }
.unstaged { color: $removed; }
.spinner { color: $done; }
.ahead { color: $added; }
.behind { color: $removed; }
.gone { color: $removed; }
.pull-request { color: $link; }
.unseen { color: $attention; text-style: bold; }
.checks-passed { color: $added; }
.checks-failed { color: $removed; }
.checks-running { color: $attention; }
.review-approved { color: $added; }
.review-changes { color: $removed; }
.repo-branch { color: $link; }
.repo-location { color: $done; }
.current { color: $attention; text-style: bold; }

Span.diff-header { color: $fg; text-style: bold; }
Span.diff-added { color: $added; }
Span.diff-removed { color: $removed; }
Span.diff-hunk { color: $muted; background: #111d2e; }
/* The rich view of a diff (ADR 44): a bar for each file, the line numbers, and the changed lines and words. */
Span.diff-file-header { color: $fg; background: $subtle; text-style: bold; }
Span.diff-line-number { color: $muted; }
/*
 * The review remarks of a pull request in its diff (ADR 55): their rule and their marks in the gutter, and
 * the header of each comment: a band behind it, and its author.
 */
Span.diff-thread { color: $attention; }
Span.diff-thread-header { background: $subtle; }
Span.diff-thread-author { color: $fg; text-style: bold; }
Span.diff-cursor { background: $selection; }
Span.diff-added-line { color: $fg; background: #12261e; }
Span.diff-added-word { color: $fg; background: #1a4a29; }
Span.diff-removed-line { color: $fg; background: #301b1f; }
Span.diff-removed-word { color: $fg; background: #6b2b2b; }

/* The code of the rich view, by its syntax (ADR 53), in the colours of GitHub's code view. */
Span.syntax-keyword { color: #ff7b72; }
Span.syntax-string { color: #a5d6ff; }
Span.syntax-comment { color: #8b949e; }
Span.syntax-number { color: #79c0ff; }

Span.current-branch { color: $attention; text-style: bold; }
Span.sha { color: $link; }
Span.tag { color: $added; }
Span.copied { color: $accent; text-style: bold; }
Span.bold { text-style: bold; }

/* The draft box of a new pull request, when it has the focus: reversed, as a cursor. */
.checkbox:focus { text-style: reversed; }

/* The comments on a pull request, written in Markdown. */
MarkdownElement {
    heading-1-color: $fg;
    heading-1-text-style: bold;
    heading-2-color: $fg;
    heading-2-text-style: bold;
    heading-3-text-style: bold;
    heading-4-text-style: bold;
    heading-5-text-style: bold;
    heading-6-text-style: bold;
    link-color: $link;
    link-text-style: underlined;
    inline-code-color: #a5d6ff;
    code-block-color: $fg;
    blockquote-color: $muted;
    blockquote-text-style: italic;
    list-marker-color: $muted;
    horizontal-rule-color: $border;
    task-checked-color: $added;
    html-color: $muted;
}
