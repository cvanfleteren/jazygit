/*
 * No colours at all: every element takes the terminal's own colours and the borders tamboui draws by default.
 * The highlighted row of the pane in use is reversed, and what is behind a popup is dimmed by the terminal.
 * Only what cannot be told otherwise is styled, by attribute alone.
 */

/*
 * The pane in use, the area of the content panel that has the focus, and the field of a popup that has it: a double
 * border.
 */
Panel.focused, RichTextAreaElement:focus, TextInputElement:focus, TextAreaElement:focus {
    border-type: double;
}

/* The draft box of a new pull request, when it has the focus: reversed, as a cursor. */
.checkbox:focus { text-style: reversed; }

.disabled { text-style: crossed-out; }

/* The rich view of a diff (ADR 44): the bar of each file and the changed words are reversed. */
Span.diff-file-header { text-style: reversed; }
Span.diff-added-word { text-style: reversed; }
Span.diff-removed-word { text-style: reversed; }

/*
 * The review remarks of a pull request in its diff (ADR 55): their rule and their marks in the gutter, and the
 * author of each comment, in bold.
 */
Span.diff-thread { text-style: bold; }
Span.diff-thread-author { text-style: bold; }
Span.diff-cursor { text-style: reversed; }
