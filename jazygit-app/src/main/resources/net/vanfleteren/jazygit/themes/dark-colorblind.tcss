/*
 * The dark theme, readable with red/green colour blindness: good is blue and bad is vermillion instead of
 * green and red, from the Okabe-Ito palette. Yellow, for what is still running, is much lighter than
 * vermillion, so the two stay apart.
 */
$border: dark-gray;
$accent: cyan;
$selection: dark-gray;
$good: #56b4e9;
$bad: #d55e00;
$running: #f0e442;
$hunk: #cc79a7;

Panel, TextInputElement, TextAreaElement, RichTextAreaElement {
    border-type: rounded;
    border-color: $border;
}

/* The pane in use, and the field of a popup that has the focus. */
Panel.focused, TextInputElement:focus, TextAreaElement:focus {
    border-color: $accent;
}

/* Popups, which otherwise take the terminal's own colour. */
DialogElement {
    border-color: $accent;
}

/*
 * The highlighted row: in the left pane in use, and in popups; in the other left panes it is hidden, as the
 * empty rule says. Only what these rules declare themselves is laid over the row.
 */
ListElement-item:selected, TreeElement-node:selected, .selection {
    background: $selection;
}

.inactive-selection {
}

/* Plain text on the highlighted row; the coloured pieces of the row keep their colours. */
.selected-text { color: white; }

/*
 * Behind an open popup, text in the plain colour takes this one; the rest is dimmed by the terminal, which
 * not every terminal does for its default colour.
 */
.backdrop { color: #808080; }

.bold { text-style: bold; }
.dim { text-style: dim; }
.error { color: $bad; }
.notice { color: $running; }
.in-progress { color: $bad; text-style: bold; }
.disabled { text-style: crossed-out dim; }
.staged { color: $good; }
.unstaged { color: $bad; }
.spinner { color: $running; }
.ahead { color: $good; }
.behind { color: $bad; }
.gone { color: $bad; text-style: dim; }
.pull-request { color: cyan; }
.unseen { color: $running; text-style: bold; }
.checks-passed { color: $good; }
.checks-failed { color: $bad; }
.checks-running { color: $running; }
.review-approved { color: $good; }
.review-changes { color: $bad; }
.repo-branch { color: cyan; }
.repo-location { color: $hunk; }
.current { color: yellow; text-style: bold; }

Span.diff-header { text-style: bold; }
Span.diff-added { color: $good; }
Span.diff-removed { color: $bad; }
Span.diff-hunk { color: $hunk; }
/* The rich view of a diff (ADR 44): a bar for each file, the line numbers, and the changed lines and words. */
Span.diff-file-header { text-style: reversed; }
Span.diff-line-number { color: dark-gray; }
Span.diff-added-line { color: $good; background: #0e2a3a; }
Span.diff-added-word { color: $good; background: #1b4f6e; }
Span.diff-removed-line { color: $bad; background: #33190a; }
Span.diff-removed-word { color: $bad; background: #6b3000; }

/* The code of the rich view, by its syntax (ADR 53). */
Span.syntax-keyword { color: #cc79a7; }
Span.syntax-string { color: #f0e442; }
Span.syntax-comment { color: #999999; }
Span.syntax-number { color: #e69f00; }

Span.current-branch { color: yellow; }
Span.sha { color: yellow; }
Span.tag { color: $good; }
Span.copied { color: cyan; text-style: bold; }
Span.bold { text-style: bold; }

/* The draft box of a new pull request, when it has the focus: reversed, as a cursor. */
.checkbox:focus { text-style: reversed; }

/* The comments on a pull request, written in Markdown. */
MarkdownElement {
    heading-1-color: cyan;
    heading-1-text-style: bold;
    heading-2-color: cyan;
    heading-2-text-style: bold;
    heading-3-text-style: bold;
    heading-4-text-style: bold;
    heading-5-text-style: bold;
    heading-6-text-style: bold;
    link-color: $good;
    link-text-style: underlined;
    inline-code-color: $running;
    code-block-color: dark-gray;
    blockquote-text-style: dim italic;
    list-marker-color: cyan;
    horizontal-rule-color: dark-gray;
    task-checked-color: $good;
    html-text-style: dim;
}
