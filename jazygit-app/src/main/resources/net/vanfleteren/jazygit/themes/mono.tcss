/*
 * Mostly black and white, after how the dark theme looks dimmed behind a popup: grey text on black, and only
 * muted colours for what needs telling apart, like good and bad.
 */
$fg: #b8b8b8;
$bright: #e8e8e8;
$bg: #000000;
$muted: #6c6c6c;
$border: #3a3a3a;
$accent: #d0d0d0;
$selection: #3a3a3a;
$good: #7f9f7f;
$bad: #b5654a;
$running: #a89060;
$hunk: #7f8fa6;
$sha: #9a7b3c;

* {
    color: $fg;
    background: $bg;
}

Panel, TextInputElement, TextAreaElement, RichTextAreaElement {
    border-type: rounded;
    border-color: $border;
}

/* The pane in use, and the field of a popup that has the focus. */
Panel.focused, TextInputElement:focus, TextAreaElement:focus {
    border-color: $accent;
}

/* Popups, which otherwise take the terminal's own colour. */
DialogElement {
    border-color: $accent;
}

/*
 * The highlighted row: in the left pane in use, and in popups; in the other left panes it is hidden, as the
 * empty rule says. Only what these rules declare themselves is laid over the row.
 */
ListElement-item:selected, TreeElement-node:selected, .selection {
    background: $selection;
}

.inactive-selection {
}

/* Plain text on the highlighted row; the coloured pieces of the row keep their colours. */
.selected-text { color: $bright; }

/*
 * Behind an open popup, text in the plain colour takes this one; the rest is dimmed by the terminal, which
 * not every terminal does for its default colour.
 */
.backdrop { color: #5a5a5a; }

.bold { color: $bright; text-style: bold; }
.dim { color: $muted; }
.error { color: $bad; }
.notice { color: $running; }
.in-progress { color: $bad; text-style: bold; }
.disabled { color: $muted; text-style: crossed-out; }
.staged { color: $good; }
.unstaged { color: $bad; }
.spinner { color: $running; }
.ahead { color: $good; }
.behind { color: $bad; }
.gone { color: $muted; }
.pull-request { color: $hunk; }
.unseen { color: $running; text-style: bold; }
.checks-passed { color: $good; }
.checks-failed { color: $bad; }
.checks-running { color: $running; }
.review-approved { color: $good; }
.review-changes { color: $bad; }
.repo-branch { color: $hunk; }
.repo-location { color: $muted; }
.current { color: $bright; text-style: bold; }

Span.diff-header { color: $bright; text-style: bold; }
Span.diff-added { color: $good; }
Span.diff-removed { color: $bad; }
Span.diff-hunk { color: $hunk; }
/* The rich view of a diff (ADR 44): a bar for each file, the line numbers, and the changed lines and words. */
Span.diff-file-header { color: $bright; text-style: reversed; }
Span.diff-line-number { color: $muted; }
/*
 * The review remarks of a pull request in its diff (ADR 55): their rule and their marks in the gutter, and
 * the header of each comment: a band behind it, and its author.
 */
Span.diff-thread { color: $bright; }
Span.diff-thread-header { background: #1c1c1c; }
Span.diff-thread-author { color: $bright; text-style: bold; }
Span.diff-added-line { color: $good; }
Span.diff-added-word { color: $good; text-style: reversed; }
Span.diff-removed-line { color: $bad; }
Span.diff-removed-word { color: $bad; text-style: reversed; }

/* The code of the rich view, by its syntax (ADR 53). */
Span.syntax-keyword { color: $bright; }
Span.syntax-string { color: #9a9a9a; }
Span.syntax-comment { color: $muted; }
Span.syntax-number { color: $bright; }

Span.current-branch { color: $bright; text-style: bold; }
Span.sha { color: $sha; }
Span.tag { color: $good; }
Span.copied { color: $bright; text-style: bold; }
Span.bold { color: $bright; text-style: bold; }

/* The draft box of a new pull request, when it has the focus: reversed, as a cursor. */
.checkbox:focus { text-style: reversed; }

/* The comments on a pull request, written in Markdown. */
MarkdownElement {
    heading-1-color: $bright;
    heading-1-text-style: bold;
    heading-2-color: $bright;
    heading-2-text-style: bold;
    heading-3-text-style: bold;
    heading-4-text-style: bold;
    heading-5-text-style: bold;
    heading-6-text-style: bold;
    link-color: $hunk;
    link-text-style: underlined;
    inline-code-color: $sha;
    code-block-color: $border;
    blockquote-color: $muted;
    blockquote-text-style: italic;
    list-marker-color: $bright;
    horizontal-rule-color: $border;
    task-checked-color: $good;
    html-color: $muted;
}
