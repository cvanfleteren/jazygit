    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-clean-plugin</artifactId>
                    <version>3.5.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>3.5.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.6.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-install-plugin</artifactId>
                    <version>3.2.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <version>3.2.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-site-plugin</artifactId>
                    <version>3.22.0</version>
                </plugin>
                <plugin>
                    <groupId>com.diffplug.spotless</groupId>
                    <artifactId>spotless-maven-plugin</artifactId>
                    <version>${spotless.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-checkstyle-plugin</artifactId>
                    <version>3.6.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.16.0</version>
                    <configuration>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                            <path>
                                <groupId>com.google.errorprone</groupId>
                                <artifactId>error_prone_core</artifactId>
                                <version>${errorprone.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                    <!-- ErrorProne itself is switched on by the errorprone profile; on the processor path alone it
                         does nothing. -->
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.5.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-shade-plugin</artifactId>
                    <version>3.6.2</version>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>exec-maven-plugin</artifactId>
                    <version>3.7.0</version>
                </plugin>
                <plugin>
                    <groupId>org.graalvm.buildtools</groupId>
                    <artifactId>native-maven-plugin</artifactId>
                    <version>${native-maven-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.pitest</groupId>
                    <artifactId>pitest-maven</artifactId>
                    <version>${pitest.version}</version>
                    <dependencies>
                        <dependency>
                            <groupId>org.pitest</groupId>
                            <artifactId>pitest-junit5-plugin</artifactId>
                            <version>${pitest-junit5-plugin.version}</version>
                        </dependency>
                    </dependencies>
                    <configuration>
                        <targetClasses>
                            <param>net.vanfleteren.jazygit.*</param>
                        </targetClasses>
                        <targetTests>
                            <param>net.vanfleteren.jazygit.*</param>
                        </targetTests>
                        <!-- ArchUnit checks the structure; it runs the code under no test and kills no mutant. -->
                        <excludedTestClasses>
                            <param>*ArchitectureTest</param>
                        </excludedTestClasses>
                        <jvmArgs>
                            <value>-Duser.language=en</value>
                            <value>-Duser.country=US</value>
                        </jvmArgs>
                        <threads>${pitest.threads}</threads>
                        <timestampedReports>false</timestampedReports>
                        <outputFormats>
                            <param>HTML</param>
                            <param>XML</param>
                        </outputFormats>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- A test JVM lives seconds, mostly warming up: C1 alone compiles its code sooner. The app's
                         tests that wait for the timer to read the status again tick every second, not every 3 s. -->
                    <argLine>-Duser.language=en -Duser.country=US -XX:TieredStopAtLevel=1 -Djazygit.refreshInterval=1000</argLine>
                    <!-- Several JVMs, as many as test.forks says. Not JUnit's in-JVM parallelism by default: while one
                         test's tamboui render loop runs, another test can't draw outside of one. -->
                    <forkCount>${test.forks}</forkCount>
                    <reuseForks>true</reuseForks>
                    <!-- Tests run gh and git as fakes, which inherit the environment: a token exported in the shell
                         would leak into what they report, and into which account gh uses. GIT_SSH_COMMAND goes
                         before a repository's core.sshCommand, so one exported in the shell would skip the fake ssh
                         a test configures. -->
                    <excludedEnvironmentVariables>GH_TOKEN,GITHUB_TOKEN,GH_ENTERPRISE_TOKEN,GITHUB_ENTERPRISE_TOKEN,GIT_SSH_COMMAND</excludedEnvironmentVariables>
                </configuration>
            </plugin>
            <!-- Mutation testing on demand only, it's no part of verify: mvn test-compile pitest:mutationCoverage -->
            <plugin>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-maven</artifactId>
            </plugin>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <configuration>
                    <java>
                        <palantirJavaFormat>
                            <version>${palantir-java-format.version}</version>
                        </palantirJavaFormat>
                        <removeUnusedImports/>
                    </java>
                </configuration>
                <!-- Formats the sources on every local build; the ci profile checks instead. -->
                <executions>
                    <execution>
                        <id>spotless-apply</id>
                        <phase>process-sources</phase>
                        <goals>
                            <goal>apply</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <dependencies>
                    <dependency>
                        <groupId>com.puppycrawl.tools</groupId>
                        <artifactId>checkstyle</artifactId>
                        <version>${checkstyle.version}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <!-- Relative to where Maven runs, the root, like ErrorProne's ApiIgnorableList: an absolute path
                         would differ per checkout and keep the build cache from reusing another checkout's build. -->
                    <configLocation>checkstyle.xml</configLocation>
                    <includeTestSourceDirectory>true</includeTestSourceDirectory>
                    <consoleOutput>true</consoleOutput>
                    <violationSeverity>error</violationSeverity>
                </configuration>
                <executions>
                    <execution>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- The JMH benchmarks, on demand only, no part of verify or CI:
             ./mvnw -Pbench -pl jazygit-benchmarks -am package -DskipTests
             java -jar jazygit-benchmarks/target/benchmarks.jar -->
        <profile>
            <id>bench</id>
            <modules>
                <module>jazygit-benchmarks</module>
            </modules>
        </profile>
        <!-- ErrorProne, on unless -Derrorprone.skip is given. CI's verify and jar jobs leave it out: the checks job
             compiles with it, and in verify it doubles the time the main sources take to compile. On as well for
             -Derrorprone.skip=false: only true switches it off. -->
        <profile>
            <id>errorprone</id>
            <activation>
                <property>
                    <name>errorprone.skip</name>
                    <value>!true</value>
                </property>
            </activation>
            <build>
                <pluginManagement>
                    <plugins>
                        <plugin>
                            <groupId>org.apache.maven.plugins</groupId>
                            <artifactId>maven-compiler-plugin</artifactId>
                            <executions>
                                <!-- ErrorProne checks the main sources only; test-compile leaves -Xplugin out. -->
                                <execution>
                                    <id>default-compile</id>
                                    <configuration>
                                        <compilerArgs combine.children="append">
                                            <arg>-XDcompilePolicy=simple</arg>
                                            <arg>--should-stop=ifError=FLOW</arg>
                                            <!-- Every call into our code or Vavr must use its result, without
                                                 annotating the code; the calls in errorprone-ignorable-results.txt
                                                 are the exception. -->
                                            <arg>-Xplugin:ErrorProne -XepOpt:CheckReturnValue:Packages=net.vanfleteren.jazygit,io.vavr -XepOpt:CheckReturnValue:ApiIgnorableList=errorprone-ignorable-results.txt -Xep:UnnecessaryLambda:OFF -Xep:JavaTimeDefaultTimeZone:OFF -Xep:MissingSummary:OFF</arg>
                                        </compilerArgs>
                                    </configuration>
                                </execution>
                            </executions>
                        </plugin>
                    </plugins>
                </pluginManagement>
            </build>
        </profile>
        <!-- On by itself in CI (GitHub Actions sets CI=true): fail on unformatted code instead of reformatting it, and
             a test JVM per core. -->
        <profile>
            <id>ci</id>
            <activation>
                <property>
                    <name>env.CI</name>
                </property>
            </activation>
            <properties>
                <test.forks>1C</test.forks>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.diffplug.spotless</groupId>
                        <artifactId>spotless-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>spotless-apply</id>
                                <phase>none</phase>
                            </execution>
                            <execution>
                                <id>spotless-check</id>
                                <phase>process-sources</phase>
                                <goals>
                                    <goal>check</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
