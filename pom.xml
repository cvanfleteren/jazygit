<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>net.vanfleteren</groupId>
    <artifactId>jazygit-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>jazygit-parent</name>
    <description>A lazygit-style terminal UI for Git, built with TamboUI</description>

    <!-- json reads JSON as values; syntax lexes a line of code; process runs a program; git and gh run git and gh,
         each knowing nothing of the other or of the application. On top of them the application, in layers
         (ADR 136): lens, image and settings; state, the model; ui, the views; content, the content panel and the
         rich diff, beside features, the groups of features; app, which wires them together. test-support holds what the architecture tests share. -->
    <modules>
        <module>jazygit-test-support</module>
        <module>jazygit-lib</module>
        <module>jazygit-core</module>
        <module>jazygit-kernel</module>
        <module>jazygit-features</module>
        <module>jazygit-app</module>
        <module>jazygit-github-app-tests</module>
    </modules>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <tamboui.version>0.7.0</tamboui.version>
        <junit.version>6.1.3</junit.version>
        <lombok.version>1.18.48</lombok.version>
        <slf4j.version>2.0.20</slf4j.version>
        <zt-exec.version>1.13.0</zt-exec.version>
        <archunit.version>1.5.1</archunit.version>
        <night-config.version>3.9.0</night-config.version>
        <!-- The version tamboui-markdown brings along, of commonmark and of its extension for tables. Declared only
             because jazygit compiles against both, which tamboui declares as runtime; keep it equal to tamboui's and
             let a tamboui bump move it. -->
        <commonmark.version>0.28.0</commonmark.version>
        <picocli.version>4.7.7</picocli.version>
        <parsson.version>1.1.9</parsson.version>
        <snakeyaml-engine.version>3.2</snakeyaml-engine.version>
        <spotless.version>3.11.0</spotless.version>
        <palantir-java-format.version>2.102.0</palantir-java-format.version>
        <checkstyle.version>14.4.0</checkstyle.version>
        <errorprone.version>2.52.0</errorprone.version>
        <native-maven-plugin.version>1.1.19</native-maven-plugin.version>
        <pitest.version>1.30.2</pitest.version>
        <pitest-junit5-plugin.version>1.2.3</pitest-junit5-plugin.version>
        <pitest.threads>8</pitest.threads>
        <jmh.version>1.37</jmh.version>
        <!-- Test JVMs: one per two cores. On 32 cores the app's tests take as long with 16 as with 32, and the machine
             stays usable meanwhile; the ci profile takes one per core, as a runner has only four. -->
        <test.forks>0.5C</test.forks>
    </properties>

